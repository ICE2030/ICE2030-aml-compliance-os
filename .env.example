# AML Compliance OS - Environment Configuration
# Copy this file to .env and adjust values as needed

# Database
DATABASE_URL=sqlite+aiosqlite:///./aml_compliance.db

# Security
SECRET_KEY=aml-compliance-os-dev-secret-key-change-in-production

# Default Admin
DEFAULT_ADMIN_EMAIL=admin@aml-os.sa
DEFAULT_ADMIN_PASSWORD=admin123

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
